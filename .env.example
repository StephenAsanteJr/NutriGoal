# Copy to .env.local and fill in what you need. Every integration is optional:
# without keys, NutriGoal runs with demo checkout and rule-based (non-AI) helpers.

# Session cookie signing secret (required in production; generated automatically in development)
SESSION_SECRET=replace-with-a-long-random-string

# --- Claude (AI support agent, voice-mode formatting, photo body-scan estimates) ---
# Model: claude-opus-5-5 via the Anthropic Messages API.
ANTHROPIC_API_KEY=

# --- Stripe (real checkout + proof-of-payment receipts) ---
# Use test-mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` or your webhook endpoint
STRIPE_WEBHOOK_SECRET=
# Public URL of the app (used for Stripe redirect URLs); defaults to the request host
# APP_URL=http://localhost:3000

# --- Epic MyChart (SMART on FHIR, read-only labs and vitals) ---
# Register a free app at https://fhir.epic.com (patient-facing, public client, PKCE),
# redirect URI: <APP_URL>/api/integrations/epic/callback
EPIC_CLIENT_ID=
# Defaults to Epic's public sandbox; set to a health system's FHIR R4 base URL in production
# EPIC_FHIR_BASE=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4

# --- Google Maps trainers (optional; adds unverified local trainers to the 5–10 mile search) ---
GOOGLE_PLACES_API_KEY=

# --- Sign in with Google / Apple / SSO (each provider appears once its values are set) ---
# Redirect URIs to register: <APP_URL>/auth/oauth/google/callback · /apple/callback · /sso/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# SSO_LABEL=Continue with Okta

# --- Demo copy only: load fictional sample data on a fresh database, and show the demo banner ---
# NUTRIGOAL_SEED_DEMO=1
# NUTRIGOAL_DEMO_BANNER=on
# NUTRIGOAL_DEMO_PASSWORD=

# Optional: custom SQLite path (defaults to ./data/nutrigoal.db)
# NUTRIGOAL_DB=/absolute/path/to/nutrigoal.db
