{
  "expo": {
    "name": "NutriGoal",
    "slug": "nutrigoal",
    "scheme": "nutrigoal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#051c2c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nutrigoal.app"
    },
    "android": {
      "package": "com.nutrigoal.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://nutrigoal-production.up.railway.app",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "35e29227-857d-4224-b384-b86aab890fc9"
      }
    },
    "owner": "21isasavage"
  }
}
